{
  "name": "millennium-falcon-challenge",
  "private": true,
  "version": "0.0.0",
  "description": "What are the odds? -- Millennium Falcon challenge monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "link:cli": "pnpm --filter @falcon/cli exec pnpm add -g .",
    "dev:api": "pnpm --filter @falcon/api run dev",
    "dev:web": "pnpm --filter @falcon/web run dev",
    "test": "pnpm -r --filter=./packages/* run test",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
