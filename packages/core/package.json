{
  "name": "@falcon/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Millennium Falcon routing config, database access, and odds-of-success algorithm.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
